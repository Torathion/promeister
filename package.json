    "abort",
    "interrupt",
    "timeout",
    "data structure",
    "utility"
  ],
  "author": "Torathion",
  "homepage": "https://github.com/Torathion/promeister",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Torathion/promeister.git"
  },
  "bugs": {
    "url": "https://github.com/Torathion/promeister/issues"
  },
  "sideEffects": false,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.25.1",
    "eslint-config-shiny": "^4.3.1",
    "jiti": "^2.7.0",
    "tsdown": "^0.22.14",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "bitbob": "^3.0.1",
    "typestar": "^3.0.1"
  }
