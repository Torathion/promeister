{
  "name": "promeister",
  "version": "1.0.2",
  "description": "Extended promises with a lot of vital features. The AIO Promise class.",
  "types": "./index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
